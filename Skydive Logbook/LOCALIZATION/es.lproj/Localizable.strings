// MARK: - WEATHER ALERTS:

"Wind weather title / alert" = "Clasificación del viento";
"Wind weather message / alert" = "Calma: < 0.3 m/s\nTranquilo: 0.3—1.5 m/s\nLigero: 1.6—3.3 m/s\nModerado: 3.4—5.4 m/s\nFresco: 5.5—7.9 m/s\nFuerte: 8.0—10.7 m/s\nVendaval: 10.8—13.8 m/s\nVendaval fuerte: 13.9—17.1 m/s\nTemporal: 17.2—20.7 m/s\nTormenta: 20.8—24.4 m/s\nTormenta violenta: 24.5—28.4 m/s\nHuracán: >32.7 m/s";

"Temperature weather title / alert" = "Sensación térmica";
"Temperature weather message / alert" = "El indicador «Sensación térmica» puede diferir de la temperatura real, reflejando cómo percibe la temperatura una persona. El indicador «Sensación térmica» está influenciado por las características del viento y los niveles de humedad.";

"Cloud cover weather title / alert" = "Cobertura de nubes";
"Cloud cover weather message / alert" = "La cobertura de nubes se mide en porcentaje. Normalmente se expresa en las partes del cielo ocupadas por nubes.";

"Humidity weather title / alert" = "Humedad";
"Humidity weather message / alert" = "La humedad relativa, o simplemente humedad, es la relación entre la cantidad de humedad en el aire y la cantidad máxima que puede contener el aire.";

"Dew point weather title / alert" = "Punto de rocío";
"Dew point weather message / alert" = "El punto de rocío es el valor al que debe bajar la temperatura para que se forme rocío. Esta es una forma conveniente de determinar la humedad del aire: cuanto más alto sea el punto de rocío, más húmedo se siente el aire. Si el punto de rocío coincide con la temperatura actual, significa que la humedad relativa del aire es del 100% y puede formarse rocío o niebla.";

"Visibility weather title / alert" = "Visibilidad";
"Visibility weather message / alert" = "La visibilidad muestra a qué distancia de ti mismo puedes ver claramente objetos como edificios y colinas. La visibilidad es una medida de la transparencia del aire y no tiene en cuenta la cantidad de luz solar o la presencia de obstáculos.";

"Precipitation weather title / alert" = "Precipitación";
"Precipitation weather message / alert" = "La cantidad de precipitación es la altura de la capa de agua en milímetros que se formaría en la superficie de la Tierra si fuera completamente plana. La cantidad de precipitación en milímetros es numéricamente igual a la masa de agua que cayó en una superficie horizontal de 1 metro cuadrado.";

"Pressure weather title / alert" = "Presión";
"Pressure weather message / alert" = "La tabla muestra las desviaciones de la norma de presión relativas a tu ubicación. La presión habitual para las personas es de 760 milímetros de mercurio. Pero la presión atmosférica normal para cada persona depende de la región en la que se encuentre, y la presión de la región depende de la altitud del área.";

"UvIndex weather title / alert" = "Índice UV";
"UvIndex weather message / alert" = "El índice UV (UFI), desarrollado por la Organización Mundial de la Salud, indica la potencia de la radiación ultravioleta. Cuanto más alto sea el índice UV, más peligroso es estar al sol y más rápido puede dañar tu salud. Al seguir el índice UV, puedes decidir cuándo protegerte del sol y cuándo es mejor no salir al exterior.";

