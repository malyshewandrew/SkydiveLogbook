"Temperature weather title / alert" = "ऐसा लगता है";
"Temperature weather message / alert" = "इंडिकेटर 'ऐसा लगता है' वास्तविक तापमान से भिन्न हो सकता है, जो एक व्यक्ति द्वारा तापमान को कैसे महसूस किया जाता है को दर्शाता है। 'ऐसा लगता है' इंडिकेटर हवा की गति और नमी स्तरों से प्रभावित होता है।";

"Cloud cover weather title / alert" = "बादल कवर";
"Cloud cover weather message / alert" = "बादल कवर को प्रतिशत में मापा जाता है। यह आमतौर पर बादलों द्वारा अधिगृहीत आकाश के हिस्सों में व्यक्त किया जाता है।";

"Humidity weather title / alert" = "नमी";
"Humidity weather message / alert" = "सापेक्ष नमी, या बस नमी, वायु में नमी की मात्रा को वायु में बन सकने वाली अधिकतम मात्रा से अनुपातित करती है।";

"Dew point weather title / alert" = "टाइफॉर्मेशन प्वाइंट";
"Dew point weather message / alert" = "टाइफॉर्मेशन प्वाइंट वह मान है जिस पर तापमान को घटाने की आवश्यकता होती है ताकि शांति बन सके। यह वायु की नमी का निर्धारण करने का एक सुविधाजनक तरीका है: ज्यादा टाइफॉर्मेशन प्वाइंट, वायु की नमी ज्यादा होती है।";

"Visibility weather title / alert" = "दृश्यता";
"Visibility weather message / alert" = "दृश्यता दिखाती है कि आप स्पष्ट रूप से वस्तुओं जैसे इमारतें और पहाड़ों को कितनी दूरी से देख सकते हैं। दृश्यता वायु के पारदर्शिता का मापन है और सूर्य की प्रकाश की मात्रा या बाधाओं की उपस्थिति को ध्यान में नहीं लेता।";

"Precipitation weather title / alert" = "वर्षा";
"Precipitation weather message / alert" = "वर्षा की मात्रा पृथ्वी की सतह पर पानी की परत की ऊंचाई मेटर में है जो कि पूरी तरह से समतल होती है";

"Pressure weather title / alert" = "दबाव";
"Pressure weather message / alert" = "यह तालिका आपकी स्थानांतरित स्थिति के अनुसार दबाव सामान्य से किए गए विचलनों को दिखाता है। लोगों के लिए सामान्य दबाव 760 मिमी ऑफ़ मरक्यरी होता है। लेकिन प्रत्येक व्यक्ति के लिए सामान्य वायव्य दबाव उस क्षेत्र पर निर्भर करता है जिसमें वह स्थित है, और क्षेत्र का दबाव क्षेत्र की ऊंचाई पर निर्भर करता है।";

"UvIndex weather title / alert" = "यूवी इंडेक्स";
"UvIndex weather message / alert" = "यूवी इंडेक्स (UFI), जो विश्व स्वास्थ्य संगठन द्वारा विकसित किया गया है, यह अल्ट्रावायलेट रेडिएशन की शक्ति को दर्शाता है। यूवी इंडेक्स का उच्च होना सूर्य के नीचे होने के लिए ज्यादा खतरनाक होने का संकेत है और यह आपके स्वास्थ्य को तेजी से हानि पहुंचा सकता है। यूवी इंडेक्स को ट्रैक करके, आप सूर्य से खुद को सुरक्षित रखने का निर्णय कर सकते हैं और कब बाहर न जाने का बेहतर है यह भी तय कर सकते हैं।";

